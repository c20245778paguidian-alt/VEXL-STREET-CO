
---
const { category, title, desc } = Astro.props;
---

<div class="card">
  <div class="card-content">
    <p class="category">{category}</p>
    <h3>{title}</h3>
    <p>{desc}</p>
    <a href="/contact">Discuss a Similar System</a>
  </div>
</div>

<style>
  .card {
    background: #111b2e;
    color: #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid #24344e;
    transition: transform 0.3s;
  }

  .card:hover {
    transform: translateY(-8px);
  }

  .card-content {
    padding: 22px;
  }

  .category {
    color: #38bdf8;
    font-size: 11px;
    font-weight: bold;
    letter-spacing: 1.5px;
    margin-bottom: 12px;
  }

  .card-content h3 {
    margin-bottom: 10px;
  }

  .card-content p {
    color: #94a3b8;
    margin-bottom: 20px;
  }

  .card-content a {
    display: inline-block;
    background: #38bdf8;
    color: #08111f;
    padding: 10px 18px;
    text-decoration: none;
    font-weight: bold;
  }
</style>
