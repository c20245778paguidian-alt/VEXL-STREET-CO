
---
const { image, title, desc } = Astro.props;
---

<div class="card">
  <div class="card-image">
    <img src={image} alt={title} />
  </div>

  <div class="card-content">
    <h3>{title}</h3>
    <p>{desc}</p>
    <a href="#contact">Inquire Now</a>
  </div>
</div>

<style>
  .card {
    background: #fff;
    color: #171717;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 5px 20px #0002;
    transition: transform 0.3s;
  }

  .card:hover {
    transform: translateY(-8px);
  }

  .card-image {
    position: relative;
  }

  .card-image > img:first-child {
    width: 100%;
    height: 280px;
    object-fit: cover;
    display: block;
  }


  .card-content {
    padding: 22px;
  }

  .card-content h3 {
    margin-bottom: 10px;
  }

  .card-content p {
    color: #666;
    margin-bottom: 20px;
  }

  .card-content a {
    display: inline-block;
    background: #171717;
    color: white;
    padding: 10px 18px;
    text-decoration: none;
  }
</style>
