---
import Card from "./Card.astro";

const examples = [
  {
    category: "DATABASE APPLICATION",
    title: "Inventory Management System",
    desc: "A sample system concept for tracking items, stock levels, and updates in one place."
  },
  {
    category: "INFORMATION SYSTEM",
    title: "Student Records System",
    desc: "A sample application concept for organizing student profiles and academic records."
  },
  {
    category: "WEB DEVELOPMENT",
    title: "Business Website",
    desc: "A responsive website concept that presents services and makes information easy to find."
  }
];
---

<section id="projects" class="section portfolio">
  <p class="eyebrow">PROGRAMMING AREAS</p>
  <h2>Systems I Can Build</h2>
  <p class="section-description">
    Example project directions that bring together programming,
    data management, and user-focused design.
  </p>

  <div class="cards">
    {examples.map((example) => (
      <Card category={example.category} title={example.title} desc={example.desc} />
    ))}
  </div>
</section>

<style>
  .portfolio {
    background: #0b1120;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    margin-top: 40px;
    text-align: left;
  }

  @media (max-width: 768px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>
