---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "VEXL STREET | Modern Streetwear",
  description = "VEXL STREET - Modern streetwear and timeless fashion."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
</head>
<body>
  <slot />
</body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
  }

  body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f5f5;
    color: #171717;
  }

  .eyebrow {
    color: #b99b6b;
    letter-spacing: 4px;
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 18px;
  }

  .section {
    padding: 85px 8%;
    text-align: center;
  }

  .section h2 {
    font-size: 35px;
    margin-bottom: 20px;
  }

  .section-description {
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.8;
    color: #666;
  }

  .dark {
    background: #111;
    color: white;
  }

  .dark .section-description {
    color: #ccc;
  }

  .btn {
    display: inline-block;
    background: #d6b98c;
    color: #111;
    padding: 15px 28px;
    margin-top: 25px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
  }

  .btn:hover {
    background: white;
  }
</style>
