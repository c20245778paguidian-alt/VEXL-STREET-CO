---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "IT Systems Programming | VEXL",
  description = "IT systems programming portfolio featuring web applications, database systems, and software solutions."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
</head>
<body>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
</body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
  }

  body {
    font-family: Arial, Helvetica, sans-serif;
    background: #0b1120;
    color: #e5e7eb;
  }

  .eyebrow {
    color: #38bdf8;
    letter-spacing: 3px;
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 18px;
  }

  .section {
    padding: 85px 8%;
    text-align: center;
  }

  .section h2 {
    font-size: 35px;
    margin-bottom: 20px;
  }

  .section-description {
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.8;
    color: #94a3b8;
  }

  .dark {
    background: #080d18;
    color: #e5e7eb;
  }

  .dark .section-description {
    color: #94a3b8;
  }

  .btn {
    display: inline-block;
    background: #38bdf8;
    color: #08111f;
    padding: 15px 28px;
    margin-top: 25px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
  }

  .btn:hover {
    background: #7dd3fc;
  }
</style>
