---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "IT Systems Programming | VEXL",
  description = "IT systems programming portfolio featuring web applications, database systems, and software solutions."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <script is:inline>
    const savedTheme = localStorage.getItem("theme");
    document.documentElement.dataset.theme = savedTheme === "light" ? "light" : "dark";
  </script>
</head>
<body>
  <div class="falling-leaves" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span>
    <span></span><span></span><span></span><span></span><span></span>
  </div>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <script is:inline>
    const themeToggle = document.getElementById("theme-toggle");

    if (themeToggle) {
      const updateThemeButton = () => {
        const isLight = document.documentElement.dataset.theme === "light";
        themeToggle.textContent = isLight ? "Dark mode" : "Light mode";
        themeToggle.setAttribute("aria-label", `Switch to ${isLight ? "dark" : "light"} mode`);
      };

      updateThemeButton();
      themeToggle.addEventListener("click", () => {
        const nextTheme = document.documentElement.dataset.theme === "light" ? "dark" : "light";
        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem("theme", nextTheme);
        updateThemeButton();
      });
    }
  </script>
</body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
  }

  body {
    font-family: Arial, Helvetica, sans-serif;
    background: #0b1120;
    color: #e5e7eb;
  }

  body::before {
    position: fixed;
    z-index: 1;
    inset: 0;
    background: url("/images/vexl-mark-transparent.png") center / min(76vw, 720px) no-repeat;
    content: "";
    opacity: 0.055;
    pointer-events: none;
    filter: invert(1);
  }

  .falling-leaves {
    position: fixed;
    z-index: 2;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .falling-leaves span {
    position: absolute;
    top: -8vh;
    left: var(--leaf-left);
    width: 13px;
    height: 19px;
    border-radius: 0 100% 0 100%;
    background: var(--leaf-color);
    opacity: 0.45;
    animation: leaf-fall var(--leaf-duration) linear var(--leaf-delay) infinite;
  }

  .falling-leaves span::after {
    position: absolute;
    top: 3px;
    left: 6px;
    width: 1px;
    height: 13px;
    background: #ffffff80;
    content: "";
    transform: rotate(-35deg);
  }

  .falling-leaves span:nth-child(1) { --leaf-left: 7%; --leaf-duration: 17s; --leaf-delay: -8s; --leaf-color: #34d399; }
  .falling-leaves span:nth-child(2) { --leaf-left: 16%; --leaf-duration: 22s; --leaf-delay: -17s; --leaf-color: #a3e635; }
  .falling-leaves span:nth-child(3) { --leaf-left: 28%; --leaf-duration: 19s; --leaf-delay: -4s; --leaf-color: #facc15; }
  .falling-leaves span:nth-child(4) { --leaf-left: 39%; --leaf-duration: 24s; --leaf-delay: -13s; --leaf-color: #22c55e; }
  .falling-leaves span:nth-child(5) { --leaf-left: 51%; --leaf-duration: 18s; --leaf-delay: -10s; --leaf-color: #84cc16; }
  .falling-leaves span:nth-child(6) { --leaf-left: 63%; --leaf-duration: 21s; --leaf-delay: -19s; --leaf-color: #eab308; }
  .falling-leaves span:nth-child(7) { --leaf-left: 74%; --leaf-duration: 25s; --leaf-delay: -6s; --leaf-color: #34d399; }
  .falling-leaves span:nth-child(8) { --leaf-left: 83%; --leaf-duration: 20s; --leaf-delay: -15s; --leaf-color: #a3e635; }
  .falling-leaves span:nth-child(9) { --leaf-left: 92%; --leaf-duration: 23s; --leaf-delay: -2s; --leaf-color: #facc15; }
  .falling-leaves span:nth-child(10) { --leaf-left: 34%; --leaf-duration: 26s; --leaf-delay: -21s; --leaf-color: #22c55e; }

  @keyframes leaf-fall {
    0% { transform: translate3d(0, -8vh, 0) rotate(0deg); }
    25% { transform: translate3d(26px, 22vh, 0) rotate(180deg); }
    50% { transform: translate3d(-18px, 52vh, 0) rotate(360deg); }
    75% { transform: translate3d(22px, 82vh, 0) rotate(540deg); }
    100% { transform: translate3d(-14px, 112vh, 0) rotate(720deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .falling-leaves {
      display: none;
    }
  }

  .eyebrow {
    color: #38bdf8;
    letter-spacing: 3px;
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 18px;
  }

  .section {
    padding: 85px 8%;
    text-align: center;
  }

  .section h2 {
    font-size: 35px;
    margin-bottom: 20px;
  }

  .section-description {
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.8;
    color: #94a3b8;
  }

  .dark {
    background: #080d18;
    color: #e5e7eb;
  }

  .dark .section-description {
    color: #94a3b8;
  }

  .btn {
    display: inline-block;
    background: #38bdf8;
    color: #08111f;
    padding: 15px 28px;
    margin-top: 25px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
  }

  .btn:hover {
    background: #7dd3fc;
  }

  :root[data-theme="light"] body {
    background: #fafafa;
    color: #171717;
  }

  :root[data-theme="light"] body::before {
    opacity: 0.045;
    filter: none;
  }

  :root[data-theme="light"] .hero {
    background: #fafafa;
    color: #171717;
  }

  :root[data-theme="light"] .hero-description {
    color: #5b6470;
  }

  :root[data-theme="light"] .section-description,
  :root[data-theme="light"] .dark .section-description {
    color: #5b6470;
  }

  :root[data-theme="light"] .dark,
  :root[data-theme="light"] .about,
  :root[data-theme="light"] .portfolio {
    background: #f1f3f5;
    color: #171717;
  }

  :root[data-theme="light"] .service-box,
  :root[data-theme="light"] .workflow article,
  :root[data-theme="light"] .card {
    background: #fff;
    color: #171717;
    border-color: #e1e5e9;
  }

  :root[data-theme="light"] .service-box p,
  :root[data-theme="light"] .workflow p,
  :root[data-theme="light"] .card-content p,
  :root[data-theme="light"] .about-content p:not(.eyebrow) {
    color: #5b6470;
  }

  :root[data-theme="light"] .contact-form input,
  :root[data-theme="light"] .contact-form textarea {
    border-color: #cbd2d9;
    background: #fff;
    color: #171717;
  }
</style>
